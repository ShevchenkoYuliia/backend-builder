import os
from datetime import datetime

from fastapi import FastAPI
{% if db_is_sql %}
from app.database import Base, engine, SessionDep
{% for entity in entity_contexts %}
from app.models.{{ entity.slug }} import {{ entity.name }}
{% endfor %}
{% else %}
from app.database import DatabaseDep
{% endif %}
{% for entity in entity_contexts %}
from app.routers.{{ entity.slug }} import router as {{ entity.slug }}_router
{% endfor %}

app = FastAPI(
    title="{{ project_name }}",
    description="Generated by Backend Builder Platform",
    version="1.0.0",
    root_path=os.getenv("ROOT_PATH", "/{{ project_slug }}"),
)

{% if db_is_sql %}
Base.metadata.create_all(bind=engine)
{% endif %}

{% for entity in entity_contexts %}
app.include_router({{ entity.slug }}_router, prefix="/api{{ entity.route_prefix }}", tags=["{{ entity.name }}"])
{% endfor %}
{% if project.include_auth %}
from app.routers.auth import router as auth_router
app.include_router(auth_router, prefix="/api/auth", tags=["Auth"])
{% endif %}


@app.get("/health")
async def health() -> dict[str, str]:
    return {"status": "ok", "database": "{{ project.db_type.value }}"}


@app.post("/api/seed", tags=["System"])
async def seed_database({% if db_is_sql %}db: SessionDep{% else %}db: DatabaseDep{% endif %}) -> dict[str, str]:
{% if db_is_sql %}
    try:
{% for entity in entity_contexts | reverse %}
        if not db.query({{ entity.name }}).first():
            db.add({{ entity.name }}({{ entity.seed_assignments | join(', ') }}))
{% endfor %}
        db.commit()
    except Exception as e:
        db.rollback()
        return {"status": "error", "message": str(e)}
{% else %}
{% for entity in entity_contexts | reverse %}
    if await db["{{ entity.collection_name }}"].count_documents({}) == 0:
        await db["{{ entity.collection_name }}"].insert_one(
            dict({{ entity.seed_assignments | join(', ') }})
        )
{% endfor %}
{% endif %}
    return {"status": "ok", "message": "Database seeded successfully."}
