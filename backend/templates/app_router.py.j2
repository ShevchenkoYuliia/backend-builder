from bson import ObjectId
from fastapi import APIRouter, HTTPException, status
from pydantic import BaseModel

from app.database import database
from app.schemas.{{ entity.slug }} import {{ entity.name }}Create, {{ entity.name }}Read, {{ entity.name }}Update
import app.schemas.{{ entity.slug }} as schemas

router = APIRouter()
collection = database["{{ entity.collection_name }}"]


def _serialize(document: dict) -> dict:
    return {"id": str(document["_id"]), **{k: v for k, v in document.items() if k != "_id"}}


@router.get("", response_model=list[{{ entity.name }}Read])
async def list_{{ entity.collection_name }}():
    items: list[dict] = []
    async for document in collection.find():
        items.append(_serialize(document))
    return items


@router.get("/{item_id}", response_model={{ entity.name }}Read)
async def get_{{ entity.slug }}(item_id: str):
    document = await collection.find_one({"_id": ObjectId(item_id)})
    if document is None:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found.")
    return _serialize(document)


@router.post("", response_model={{ entity.name }}Read, status_code=status.HTTP_201_CREATED)
async def create_{{ entity.slug }}(payload: {{ entity.name }}Create):
    document = {
{% for line in entity.mongo_document_lines %}
{{ line }}
{% endfor %}
    }
    result = await collection.insert_one(document)
    created = await collection.find_one({"_id": result.inserted_id})
    return _serialize(created)


@router.put("/{item_id}", response_model={{ entity.name }}Read)
async def update_{{ entity.slug }}(item_id: str, payload: {{ entity.name }}Update):
    document = await collection.find_one({"_id": ObjectId(item_id)})
    if document is None:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found.")
    update_data = payload.model_dump(exclude_unset=True)
    await collection.update_one({"_id": ObjectId(item_id)}, {"$set": update_data})
    updated = await collection.find_one({"_id": ObjectId(item_id)})
    return _serialize(updated)


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_{{ entity.slug }}(item_id: str):
    document = await collection.find_one({"_id": ObjectId(item_id)})
    if document is None:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found.")
    await collection.delete_one({"_id": ObjectId(item_id)})
    return None
