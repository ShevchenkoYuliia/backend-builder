{% if project.db_type.value == "mongodb" %}
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME={{ project_slug }}
{% elif project.db_type.value == "postgresql" %}
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/{{ project_slug }}
{% else %}
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/{{ project_slug }}
{% endif %}
